       fhir:ImplementationGuide.definition.resource.name [ fhir:value "BeExtProblemOriginType" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The type of event that triggers the problem to be evaluated - whether the problem was reported from a referring GP, etc..." ] ;
